{
  "name": "stockss-intelligence-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Indian F&O research and paper-trading backend. No broker order execution.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "npm run build && node dist/scripts/demo.js",
    "setup": "npm run build && node dist/scripts/setup.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "preflight": "npm run build && node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:performance": "npm run build && node dist/scripts/benchmark.js",
    "docs": "npm run build && node dist/scripts/openapi.js",
    "export:history": "npm run build && node dist/scripts/export-history.js",
    "export:training": "npm run build && node dist/scripts/export-training.js",
    "import:validation": "npm run build && node dist/scripts/import-validation.js",
    "format": "prettier --write src scripts tests *.json *.ts *.md",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "protobufjs": "^8.8.1",
    "rss-parser": "^3.13.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
