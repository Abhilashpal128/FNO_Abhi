# Run npm run setup to generate local authentication secrets. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATA_MODE=demo
# memory is an ephemeral fixture store, permitted ONLY in demo mode.
STORAGE_MODE=memory
MONGODB_URI=mongodb://127.0.0.1:27017/stockss?replicaSet=rs0
APP_USERNAME=owner
APP_PASSWORD_HASH=
JWT_SECRET=
TOKEN_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY_HOPS=0
UPSTOX_ANALYTICS_TOKEN=
# Optional selected underlying keys, comma separated. Empty selects a bounded universe.
UPSTOX_UNDERLYING_KEYS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank
MAX_UNDERLYINGS=12
MAX_SUBSCRIPTIONS=500
UPSTOX_REQUESTS_PER_SECOND=5
QUOTE_MAX_AGE_MS=15000
FEED_HEARTBEAT_MS=30000
CANDLE_GRACE_MS=2000
BASELINE_SESSIONS=20
BASELINE_MIN_SAMPLES=10
MIN_RVOL=1.5
VOLUME_SPIKE_RATIO=2
MIN_OPTION_VOLUME=1000
MAX_SPREAD_PCT=1.5
MIN_REWARD_RISK=1.5
MAX_ATR_PCT=3
SIMULATED_CAPITAL=100000
MAX_RISK_PER_TRADE=1000
MAX_DAILY_LOSS=3000
MAX_AGGREGATE_RISK=3000
MAX_CORRELATED_RISK=1500
MAX_DAILY_OPPORTUNITIES=5
MIN_EXPIRY_DAYS=1
STOCK_EXPIRY_BUFFER_DAYS=4
GLOBAL_NO_TRADE=false
# Conservative estimates, not a claim about current statutory charges. Verify before live use.
COSTS_VERIFIED=false
BROKERAGE_PER_ORDER=20
EXCHANGE_FEE_RATE=0.0004
SEBI_FEE_RATE=0.000001
GST_RATE=0.18
STT_SELL_RATE=0.0015
STAMP_BUY_RATE=0.00003
SLIPPAGE_BPS=10
SCHEDULER_ENABLED=true
# Only selected completed-minute observations are persisted, never raw ticks.
SNAPSHOTS_ENABLED=true
MAX_SNAPSHOT_INSTRUMENTS=60
MAX_NEARBY_OPTION_LEGS=8
SNAPSHOT_RETENTION_DAYS=7
CANDLE_MINUTE_RETENTION_DAYS=60
CANDLE_AGGREGATE_RETENTION_DAYS=365
CANDLE_DAILY_RETENTION_DAYS=1095
VOLUME_PROFILE_RETENTION_DAYS=365
OPTION_AGGREGATE_RETENTION_DAYS=90
NEWS_RETENTION_DAYS=180
# Budget includes allocated MongoDB collection and index bytes.
STORAGE_BUDGET_MB=512
STORAGE_WARN_PCT=60
STORAGE_REDUCE_PCT=75
STORAGE_CRITICAL_PCT=90
STORAGE_CHECK_INTERVAL_MS=300000
VOLUME_LOOKBACK=20
VOLUME_ANOMALY_Z=2
OUTCOME_HORIZON_MINUTES=30
VALIDATION_EMBARGO_MINUTES=30
# Optional external news services. Empty keys disable their adapters.
GNEWS_API_KEY=
NEWSAPI_KEY=
NEWS_SEARCH_QUERY=India RBI NSE earnings
# Use permitted RSS XML URLs from the official source pages; empty disables the feed.
NSE_RSS_URL=
RBI_RSS_URL=
NEWS_MAX_ITEMS=40
NEWS_MODEL_TIMEOUT_MS=30000
# Optional local inference services; no local model API keys are required.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
FINBERT_SERVICE_URL=
# Legacy alias, superseded by FINBERT_SERVICE_URL.
FINBERT_URL=
ML_INFERENCE_URL=
# Python worker settings. Its default has all model loading disabled.
FINBERT_ENABLED=false
FINBERT_MODEL=ProsusAI/finbert
LIGHTGBM_BUNDLE=
# Optional trusted RSS sources and a local JSON economic/company event calendar.
RSS_FEED_URLS=
EVENT_CALENDAR_PATH=
REQUIRE_EVENT_CALENDAR=true
